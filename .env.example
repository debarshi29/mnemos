# Copy to .env and fill in your keys.
# At least one LLM provider key is required; embeddings run locally (no key needed).

# --- LLM Provider (set LLM_PROVIDER in config.yaml to match) ---
GROQ_API_KEY=gsk_...          # https://console.groq.com  (free tier)
GOOGLE_API_KEY=AIza...        # https://aistudio.google.com (free tier)
# Ollama needs no key — just run `ollama serve` locally

# --- Optional ---
# LANGSMITH_API_KEY=          # LangSmith tracing (optional, free tier available)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=mnemos
